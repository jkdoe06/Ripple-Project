# systemd service file for running the arbitrage bot 24/7
#
# Install:
#   sudo cp arb-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable arb-bot
#   sudo systemctl start arb-bot
#
# Check status:
#   sudo systemctl status arb-bot
#   journalctl -u arb-bot -f
#
# Stop:
#   sudo systemctl stop arb-bot

[Unit]
Description=Crypto Arbitrage Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/user/Ripple-Project/autonomous-life-agent/arbitrage-bot
ExecStart=/usr/bin/python3 bot.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/user/Ripple-Project/autonomous-life-agent/arbitrage-bot/logs/daemon.log
StandardError=append:/home/user/Ripple-Project/autonomous-life-agent/arbitrage-bot/logs/daemon.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/Ripple-Project/autonomous-life-agent/arbitrage-bot/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
